datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  age             Int?
  weightKg        Float?
  heightCm        Float?
  goal            String?  // 'lose', 'maintain', 'gain'
  dailyCalories   Int?
  dailyProteinG   Int?
  dailyCarbsG     Int?
  dailyFatsG      Int?
  onboardingStep  String   @default("COMPLETED") // 'ASK_AGE', 'ASK_WEIGHT', 'ASK_HEIGHT', 'ASK_GOAL', 'COMPLETED'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  meals           Meal[]
}

model Meal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  mealType      String
  description   String
  calories      Int
  proteinG      Float
  carbsG        Float
  fatsG         Float
  createdAt     DateTime @default(now())
}
